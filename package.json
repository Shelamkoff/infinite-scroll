{
  "name": "@shelamkoff/infinite-scroll",
  "version": "1.0.1",
  "description": "Small framework-agnostic infinite scroll controller built on IntersectionObserver with loading guards, error handling, and absolute-layout support",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/dev-server.mjs /demo.html",
    "test": "node --test test/*.test.js",
    "test:types": "npm run build && node scripts/check-types.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:browser": "node --test browser-tests/*.test.mjs",
    "verify": "npm test && npm run test:types && npm run test:package && npm run test:browser",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build"
  },
  "keywords": [
    "javascript",
    "infinite-scroll",
    "intersection-observer",
    "lazy-loading",
    "pagination",
    "load-more",
    "scroll",
    "sentinel",
    "vanilla-js",
    "framework-agnostic",
    "esm",
    "typescript"
  ],
  "author": "Shelamkoff",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/infinite-scroll.git"
  },
  "homepage": "https://shelamkoff.github.io/infinite-scroll/",
  "bugs": {
    "url": "https://github.com/Shelamkoff/infinite-scroll/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  }
}
