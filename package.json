{
  "name": "@shelamkoff/infinite-scroll",
  "version": "1.0.0",
  "description": "Small framework-agnostic infinite scroll controller built on IntersectionObserver with loading guards, error handling, and absolute-layout support",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.ru.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/dev-server.mjs /demo.html",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "javascript",
    "infinite-scroll",
    "intersection-observer",
    "lazy-loading",
    "pagination",
    "load-more",
    "scroll",
    "sentinel",
    "vanilla-js",
    "framework-agnostic",
    "esm",
    "typescript"
  ],
  "author": "Shelamkoff",
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/infinite-scroll.git"
  },
  "homepage": "https://shelamkoff.github.io/infinite-scroll/",
  "bugs": { "url": "https://github.com/Shelamkoff/infinite-scroll/issues" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
